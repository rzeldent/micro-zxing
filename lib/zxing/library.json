{
    "name": "zxing",
    "version": "3.1.1",
    "description": "Thin PlatformIO wrapper for the zxing-cpp git submodule (lib/zxing/src/core/src)",
    "keywords": "barcode, zxing, qr, aztec, datamatrix, pdf417, code128",
    "repository": {
        "type": "git",
        "url": "https://github.com/zxing-cpp/zxing-cpp.git"
    },
    "license": "Apache-2.0",
    "frameworks": "*",
    "platforms": "*",
    "build": {
        "srcDir": "src/core/src",
        "includeDir": "src/core/src",
        "srcFilter": [
            "+<*>",
            "-<libzint>"
        ],
        "flags": [
            "-DZXING_INTERNAL"
        ]
    }
}
